{
  "name": "school-bus-tracking-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade School & College Bus Tracking and Safety Platform for India",
  "workspaces": [
    "backend",
    "school-dashboard",
    "parent-web",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=school-dashboard",
    "dev:parent": "npm run dev --workspace=parent-web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "school-bus-tracker",
    "postgis",
    "gps-telemetry",
    "geofencing",
    "whatsapp-first",
    "nextjs",
    "flutter"
  ],

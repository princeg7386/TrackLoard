# ==============================================================================
# Environment Configuration Template — School Bus Tracking & Safety Platform
# ==============================================================================
# NOTE: Copy this file to .env and fill in real values. Never commit .env to git.

# ------------------------------------------------------------------------------
# App & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME="School Bus Tracking System"
APP_TIMEZONE="Asia/Kolkata"
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"

# ------------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_bus_tracker?schema=public"
DB_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET="change-this-to-a-secure-random-64-character-string"
JWT_EXPIRES_IN="7d"
PARENT_TOKEN_SECRET="change-this-to-another-secure-random-64-character-string"
PARENT_TOKEN_TTL_HOURS=12

# ------------------------------------------------------------------------------
# Mapping & GIS Services (Free/OSS First)
# ------------------------------------------------------------------------------
# Default: Open Source Routing Machine (OSRM)
ROUTING_PROVIDER="osrm"
OSRM_BASE_URL="https://router.project-osrm.org"
MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# Optional fallback (Google Maps)
GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# WhatsApp & Messaging Gateway (Abstract Adapter)
# ------------------------------------------------------------------------------
# Provider options: mock | meta_cloud | twilio
MESSAGING_PROVIDER="mock"

# Meta WhatsApp Cloud API (when MESSAGING_PROVIDER=meta_cloud)
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
META_WA_WEBHOOK_VERIFY_TOKEN=""

# Twilio WhatsApp (when MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# ------------------------------------------------------------------------------
# Telemetry Ingestion Tuning
# ------------------------------------------------------------------------------
GEOFENCE_RADIUS_METERS=300
MAX_SPEED_THRESHOLD_KMH=120
SPEEDING_ALERT_THRESHOLD_KMH=60
TELEMETRY_BUFFER_FLUSH_INTERVAL_MS=5000
